# Parameterised target container.
#
#   docker build -f containers/Dockerfile.target --build-arg BASE=debian:13@sha256:9cc080028c43b27d2074d63a5f9caf7166d731494965616c1a6d2827a004585c .
#
# Deliberately minimal: this validates the catalog against a target's real
# /etc/os-release and package database. It does not install ham software —
# that arrives with the backends.
ARG BASE=debian:13@sha256:9cc080028c43b27d2074d63a5f9caf7166d731494965616c1a6d2827a004585c
FROM ${BASE}

# APT_SANDBOX_USER: leave as `_apt` (apt's default, defence-in-depth) wherever
# the container runtime is properly configured. Set to `root` ONLY on a rootless
# runtime that lacks /etc/subuid ranges, where apt cannot drop privileges to
# uid 42 and the build fails outright. Made an explicit build arg so the
# degraded mode is visible in the build command rather than baked in silently.
ARG APT_SANDBOX_USER=_apt

# IDENTITY_PACKAGE: a distribution-identity package to install from the target's
# own repo before anything reads /etc/os-release. Default empty (a no-op for the
# five targets whose base image already carries the right identity).
#
# It exists for one honest case. linuxmintd/mint22.3-amd64 is built from Ubuntu
# and ships Ubuntu's `base-files`, so its /etc/os-release reads ID=ubuntu — the
# Mint `base-files` is a version DOWNGRADE (13ubuntu10mint22.3.0 sorts below
# Ubuntu's 13ubuntu10.4 security update) and was never installed. The image is
# still genuinely Mint: it carries packages.linuxmint.com and Mint's own apt
# preferences pinning that repo. Installing `base-files/zena` lets Mint's own
# signed package set Mint's own os-release — the identity a real Mint 22.3 ISO
# ships and its priority-700 pin keeps. This is NOT forging a file (the shim the
# capability-matrix rules forbid); it is completing an incompletely-built image
# with the distribution's own package. The suite selector carries no version, so
# it does not rot when Mint revises base-files.
ARG IDENTITY_PACKAGE=""

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

# `apt_step` runs `apt-get update` and one install, and retries the pair up
# to three times a minute apart. The retry is for one measured failure and
# nothing else: deb.parrot.sh served a Packages index naming python3.13
# builds its pool no longer had, so update succeeded and install 404'd --
# four times in two hours on 2026-09-12/13 (runs 34725601481, 34726708880,
# 34727268076, 34728009036), every one green on a plain re-run minutes
# later. A mirror mid-sync is a transient; a package that really is missing
# still fails three times and the build still fails. The lists are removed
# between attempts so the next update fetches the resynced index rather
# than trusting the stale one.
RUN printf '%s\n' \
      '#!/bin/sh' \
      'set -eu' \
      'attempt=1' \
      'while :; do' \
      '  if apt-get -o APT::Sandbox::User="${APT_SANDBOX_USER:-_apt}" update \' \
      '     && apt-get -o APT::Sandbox::User="${APT_SANDBOX_USER:-_apt}" install -y "$@"; then' \
      '    rm -rf /var/lib/apt/lists/*; exit 0' \
      '  fi' \
      '  rm -rf /var/lib/apt/lists/*' \
      '  if [ "$attempt" -ge 3 ]; then echo "apt_step: failed $attempt times" >&2; exit 1; fi' \
      '  echo "apt_step: attempt $attempt failed; the mirror may be mid-sync, retrying in 60s" >&2' \
      '  attempt=$((attempt + 1)); sleep 60' \
      'done' > /usr/local/bin/apt_step \
 && chmod 0755 /usr/local/bin/apt_step

RUN if [ -n "${IDENTITY_PACKAGE}" ]; then \
      apt_step --allow-downgrades "${IDENTITY_PACKAGE}"; \
    fi

# python3-venv gives us a vendored virtualenv; we never touch system site-packages.
# bubblewrap: the offline source-build and vendor-.deb sandboxes (#381) run
# real bwrap subprocesses even under test, so the target needs it installed,
# not just mocked.
RUN apt_step --no-install-recommends \
      python3 python3-venv python3-pip ca-certificates apt-utils openssh-client git bubblewrap

# Vendored virtualenv, exactly as the shipped .deb will do (DESIGN.md §5).
RUN python3 -m venv /opt/hammunition-venv
ENV PATH="/opt/hammunition-venv/bin:${PATH}"

WORKDIR /work
COPY pyproject.toml README.md ./
COPY requirements ./requirements
COPY src ./src
# Hash-pinned (OpenSSF Scorecard: PinnedDependencies); `scripts/refresh-locks.sh`
# regenerates the lock, `scripts/check_locks.py` keeps it honest.
RUN pip install --no-cache-dir --require-hashes -r requirements/dev.txt \
 && pip install --no-cache-dir --no-deps -e .

# The whole repository, not a curated list: the list this replaced predated
# tests that read .gitignore, LICENSE, REUSE.toml and .github/, so the tests
# passed against a mounted dev checkout and failed in every CI container --
# "test the matrix, not your machine", failed from the harness side.
# .dockerignore (repo root) holds the exclusions, each with its reason.
COPY . ./

CMD ["python", "scripts/capability_matrix.py", "--check"]
